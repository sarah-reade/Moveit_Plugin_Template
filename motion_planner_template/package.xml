<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motion_planner_template</name>
  <version>0.1.0</version>
  <description>Reusable example motion planners for a MoveIt 2 planner plugin.</description>
  <maintainer email="maintainers@example.com">MoveIt Plugin Template contributors</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>rclcpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
